# Thông tin SSH để sync-deploy.sh đồng bộ nội dung deploy/ lên host
# production. Chỉ máy dev dùng — sync-deploy.sh chạy ở root (cùng chỗ với
# file này), không có script nào trên server cần tới nó, nên nó KHÔNG nằm
# trong deploy/ (khác .env.prod/.env.registry — hai file đó bắt buộc ở
# trong deploy/ vì server chỉ có mỗi thư mục đó, xem standard/deploy.md).
#
# Copy sang .env.sync (đã gitignore) rồi điền giá trị thật.
# Không bao giờ commit bản đã điền.

SSH_HOST=
SSH_USER=
# Bỏ trống thì mặc định 22
SSH_PORT=

# Đường dẫn identity file cụ thể. Bỏ trống thì dùng mặc định của ssh-agent/
# ~/.ssh/config — chỉ điền khi cần ép dùng đúng một key.
SSH_KEY=

# Thư mục gốc trên server sẽ chứa nội dung deploy/ — chính là đường dẫn bạn
# sẽ cd vào để chạy ./deploy.prod.sh. Ví dụ: /srv/sandbox-service/deploy
DEPLOY_PATH=
