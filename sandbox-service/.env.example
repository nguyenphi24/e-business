# Copy sang .env (đã gitignore) cho môi trường dev. File này ở ROOT repo,
# không phải trong backend/ — app trong backend/ phải import thẳng file này
# vào config (không copy giá trị qua tay). Cách import cụ thể theo từng
# stack — xem repo conventions/stacks/ nếu dự án dùng stack đã có
# chuẩn riêng. Lý do đặt ở root, và khi nào một thư mục con (vd. frontend/)
# buộc phải có .env riêng:
# repo conventions/standard/repo-layout.md mục ".env cục bộ".
#
# SQLite là file nhúng, không phải service chạy container — không có
# docker-compose.yml (dev) nào cả, chỉ cần đường dẫn file dưới đây.

DATABASE_PATH=./data/sandbox_service.db

# Secret bắt buộc — KHÔNG có default trong code, app chết khi thiếu.
# Sinh: openssl rand -base64 48 (SECRET_KEY), openssl rand -hex 32 (hai biến còn lại)
SECRET_KEY=replace-with-openssl-rand-base64-48
# Phải trùng SANDBOX_API_KEY bên ProcureHub (ProcureHub gửi trong header X-Api-Key)
SANDBOX_API_KEY=replace-with-openssl-rand-hex-32
# Phải trùng SANDBOX_WEBHOOK_SECRET bên ProcureHub (ký HMAC mọi callback)
SANDBOX_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Địa chỉ công khai của chính sandbox (sinh link trang thanh toán / ký / tra cứu)
PUBLIC_BASE_URL=http://localhost:28080
# Chỉ gửi callback tới / chỉ cho quay về các địa chỉ này (ProcureHub API 48000, SPA 43000)
ALLOWED_CALLBACK_PREFIXES=http://127.0.0.1:48000/,http://localhost:48000/
ALLOWED_RETURN_PREFIXES=http://localhost:43000/,http://127.0.0.1:43000/
# Thời gian giả lập cơ quan thuế cấp mã hóa đơn (giây)
EINVOICE_TAX_DELAY_SECONDS=3

SERVER_PORT=28080
