# Thông tin đăng nhập registry — dùng chung hai script:
#   build.sh         (máy dev/CI — build & push)
#   deploy.prod.sh   (host production — login & pull)
#
# Copy sang .env.registry (đã gitignore) trên TỪNG máy cần dùng rồi điền giá
# trị thật. build.sh đọc file này ở ROOT repo, deploy.prod.sh đọc trong deploy/.
# Không bao giờ commit bản đã điền.

REGISTRY_HOST=registry.example.com

# <namespace>/<repo> như trong URL repo
PROJECT_PATH=namespace/sandbox-service

# Token có quyền đọc package (thêm quyền ghi trên máy chạy build.sh)
REGISTRY_USER=
REGISTRY_PASS=
