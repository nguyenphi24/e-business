# Copy sang .env.prod (đã gitignore) và điền trước khi chạy ./deploy.prod.sh
# Không bao giờ commit bản đã điền — nó chứa secret thật.


# ===== Database (SQLite) =====
# File nằm trên volume trong container, không phải service chạy riêng —
# không có mật khẩu vì không có server nào để xác thực vào.
SANDBOX_SERVICE_DB_PATH=/data/sandbox_service.db

# ===== Bí mật ứng dụng =====
# Bắt buộc, không có default trong code — app chết lúc khởi động khi thiếu.
# Sinh giá trị: openssl rand -base64 48 (SECRET_KEY), openssl rand -hex 32 (API key, webhook secret)
SANDBOX_SERVICE_SECRET_KEY=
# Merchant (ProcureHub) gửi giá trị này trong header X-Api-Key — phải trùng SANDBOX_API_KEY bên ProcureHub.
SANDBOX_SERVICE_API_KEY=
# Ký HMAC mọi callback gửi về merchant — phải trùng SANDBOX_WEBHOOK_SECRET bên ProcureHub.
SANDBOX_SERVICE_WEBHOOK_SECRET=

# ===== Cấu hình (bắt buộc khai báo rõ ở production) =====
SANDBOX_SERVICE_ALLOWED_HOSTS=sandbox.example.com
SANDBOX_SERVICE_PUBLIC_BASE_URL=https://sandbox.example.com
# Chỉ gửi callback tới API của merchant, chỉ cho quay về SPA của merchant.
SANDBOX_SERVICE_ALLOWED_CALLBACK_PREFIXES=https://api.example.com/api/v1/webhooks/
SANDBOX_SERVICE_ALLOWED_RETURN_PREFIXES=https://app.example.com/
SANDBOX_SERVICE_EINVOICE_TAX_DELAY_SECONDS=3

# ===== Image =====
# Git short SHA mà build.sh in ra sau khi push. Cố ý KHÔNG có default và không
# bao giờ dùng "latest": tag đó bị push đè mỗi lần build nên deploy nó thì
# không biết đang chạy bản nào, rollback cũng không chắc ra đúng bits cũ.
SANDBOX_SERVICE_IMAGE_TAG=

# Cổng phía host bind vào 127.0.0.1. Phải khớp proxy_pass trong cấu hình nginx.
SANDBOX_SERVICE_HOST_PORT=8080


