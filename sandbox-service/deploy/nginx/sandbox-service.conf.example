# Server block nginx chạy trên chính host (bare-metal, không phải container).
# Cổng phía host lấy từ deploy/.env.prod. Đổi cổng thì sửa cả hai nơi.
#
# Thay sandbox-service_DOMAIN bằng domain thật trước khi dùng.
# Cài: copy vào /etc/nginx/sites-available/sandbox-service.conf, ln -s sang
# sites-enabled rồi `nginx -t && systemctl reload nginx`.

server {
    listen 80;
    server_name sandbox-service_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name sandbox-service_DOMAIN;

    ssl_certificate     /etc/ssl/sandbox-service/fullchain.pem;
    ssl_certificate_key /etc/ssl/sandbox-service/privkey.pem;

    # API chỉ nhận JSON nhỏ (hóa đơn, yêu cầu ký); không có upload tệp.
    client_max_body_size 1M;

    proxy_connect_timeout 30s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    # Cả API (/api/) lẫn trang người dùng mở trong trình duyệt (/gateway/, /einvoice/, /esign/).
    location / {
        proxy_pass http://127.0.0.1:8080;   # khớp SANDBOX_SERVICE_HOST_PORT
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    # Health check chỉ cho localhost, không phơi ra ngoài.
    location = /health/ {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8080;
    }

    # Tài liệu API bị chặn mặc định trên domain công cộng. Mở ra phải là
    # quyết định có chủ đích, kèm allowlist IP.
    location ~ ^/(docs|swagger-ui|api-docs|openapi) {
        deny all;
        return 404;
    }
}

