SECRET_KEY=replace-with-openssl-rand-base64-48
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
USE_SQLITE=false
DATABASE_NAME=procurehub
DATABASE_USER=procurehub
DATABASE_PASSWORD=procurehub
DATABASE_HOST=localhost
DATABASE_PORT=45432
CORS_ALLOWED_ORIGINS=http://localhost:43000
# Callback từ sandbox-service (cổng thanh toán, hóa đơn điện tử, ký số) ký HMAC bằng secret này — bắt buộc,
# phải trùng SANDBOX_WEBHOOK_SECRET của sandbox-service. Tạo bằng: openssl rand -hex 32
SANDBOX_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
# Bật tích hợp sandbox-service (để trống thì tắt: thanh toán dùng nút mô phỏng nội bộ, không HĐĐT, không ký số)
SANDBOX_BASE_URL=http://127.0.0.1:28080
SANDBOX_API_KEY=replace-with-the-same-key-as-sandbox-service
CALLBACK_BASE_URL=http://127.0.0.1:48000
FRONTEND_URL=http://localhost:43000
PAYMENT_SANDBOX_ENABLED=true
NOTIFICATION_STREAM_MAX_SECONDS=25
